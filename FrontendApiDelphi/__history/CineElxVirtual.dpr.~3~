program CineElxVirtual;

uses
  Vcl.Forms,
  uAPI in 'uAPI.pas',
  uLogin in 'uLogin.pas' {fLogin},
  uFrmPeliculas in 'uFrmPeliculas.pas' {frmPeliculas};

{$R *.res}

begin
  Application.Initialize;
  Application.MainFormOnTaskbar := True;

  fLogin := TfLogin.Create(Application);
  try
    if fLogin.ShowModal = mrOk then
    begin
      Application.CreateForm(TfrmPeliculas, uFrmPeliculas);
      Application.Run;
    end
    else
      Application.Terminate;
  finally
    fLogin.Free;
  end;
end.
