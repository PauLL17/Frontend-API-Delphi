implementation
   procedure TForm1.AplicarFondoMDI;
var
  hMDI: HWND;
begin
  { AplicarFondoMDI
    - Obtiene el handle del área MDI client
    - Le asigna un color de fondo oscuro como base }
  hMDI := ClientHandle;
  SetClassLong(hMDI, GCL_HBRBACKGROUND,
    COLOR_APPWORKSPACE + 1);
  InvalidateRect(hMDI, nil, True);
end;

uses
  uLogin, uAPI;

{$R *.dfm}

procedure TForm1.FormCreate(Sender: TObject);
begin
  { FormCreate de MainScreen
    - Muestra fLogin como modal antes de mostrar el principal
    - Si login correcto (mrOk): actualiza el caption con usuario y rol
    - Si se cancela: termina la aplicación }
  fLogin := TfLogin.Create(Application);
  try
    if fLogin.ShowModal = mrOk then
      Caption := 'CineElxVirtual  |  ' + sNombreUsuario + ' (' + sRolUsuario + ')'
    else
      Application.Terminate;
  finally
    fLogin.Free;
  end;
  AplicarFondoMDI;
end;

