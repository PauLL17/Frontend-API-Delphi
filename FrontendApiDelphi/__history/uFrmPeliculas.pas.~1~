unit uFrmPeliculas;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants,
  System.Classes, Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs,
  Vcl.StdCtrls, Vcl.Grids, Vcl.ComCtrls, System.JSON, uAPI;

type
  TfrmPeliculas = class(TForm)
    sgPeliculas: TStringGrid;
    gbDatos: TGroupBox;
    Label1: TLabel;
    Label2: TLabel;
    Label3: TLabel;
    Label4: TLabel;
    Label5: TLabel;
    lblID: TLabel;
    edtTitulo: TEdit;
    cmbGenero: TComboBox;
    edtDuracion: TEdit;
    edtPoster: TEdit;
    btnNuevo: TButton;
    btnGuardar: TButton;
    btnEliminar: TButton;
    btnRefrescar: TButton;
    stbEstado: TStatusBar;
    procedure FormCreate(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure sgPeliculasClick(Sender: TObject);
    procedure btnRefrescarClick(Sender: TObject);
    procedure btnNuevoClick(Sender: TObject);
    procedure btnGuardarClick(Sender: TObject);
    procedure btnEliminarClick(Sender: TObject);
  private
    FListaPeliculas: TJSONArray;
    FEditandoID: Integer;
    procedure RefrescarLista;
    procedure LimpiarCampos;
    procedure CargarPeliculaSeleccionada;
    procedure MostrarMensaje(const sTexto: string);
    function ObtenerDatosJSON: TJSONObject;
    procedure LlenarGrid;
  public
  end;

implementation

{$R *.dfm}

procedure TfrmPeliculas.FormCreate(Sender: TObject);
begin
  sgPeliculas.Cells[0, 0] := 'ID';
  sgPeliculas.Cells[1, 0] := 'Título';
  sgPeliculas.Cells[2, 0] := 'Género';
  sgPeliculas.Cells[3, 0] := 'Duración';
  sgPeliculas.Cells[4, 0] := 'Poster';

  FListaPeliculas := nil;
  FEditandoID := 0;

  if sNombreUsuario <> '' then
    MostrarMensaje(Format('Usuario: %s | Rol: %s', [sNombreUsuario, sRolUsuario]))
  else
    MostrarMensaje('No autenticado');

  RefrescarLista;
end;

procedure TfrmPeliculas.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  FreeAndNil(FListaPeliculas);
end;

procedure TfrmPeliculas.MostrarMensaje(const sTexto: string);
begin
  stbEstado.Panels[0].Text := sTexto;
end;

procedure TfrmPeliculas.LimpiarCampos;
begin
  FEditandoID := 0;
  lblID.Caption := '0';
  edtTitulo.Clear;
  cmbGenero.ItemIndex := -1;
  edtDuracion.Text := '0';
  edtPoster.Clear;
end;

procedure TfrmPeliculas.RefrescarLista;
var
  sMensaje: string;
begin
  FreeAndNil(FListaPeliculas);
  if not APIListar('peliculas', FListaPeliculas, sMensaje) then
  begin
    MostrarMensaje('Error al cargar: ' + sMensaje);
    Exit;
  end;
  LlenarGrid;
  MostrarMensaje(Format('%d películas cargadas.', [FListaPeliculas.Count]));
end;

procedure TfrmPeliculas.LlenarGrid;
var
  i: Integer;
  obj: TJSONObject;
begin
  sgPeliculas.RowCount := 1;
  if not Assigned(FListaPeliculas) then Exit;

  sgPeliculas.RowCount := FListaPeliculas.Count + 1;
  for i := 0 to FListaPeliculas.Count - 1 do
  begin
    obj := FListaPeliculas.Items[i] as TJSONObject;
    sgPeliculas.Cells[0, i+1] := obj.GetValue<string>('id', '');
    sgPeliculas.Cells[1, i+1] := obj.GetValue<string>('titulo', '');
    sgPeliculas.Cells[2, i+1] := obj.GetValue<string>('genero', '');
    sgPeliculas.Cells[3, i+1] := obj.GetValue<string>('duracion', '');
    sgPeliculas.Cells[4, i+1] := obj.GetValue<string>('poster', '');
  end;
end;

procedure TfrmPeliculas.sgPeliculasClick(Sender: TObject);
begin
  CargarPeliculaSeleccionada;
end;

procedure TfrmPeliculas.CargarPeliculaSeleccionada;
var
  nFila: Integer;
  obj: TJSONObject;
begin
  nFila := sgPeliculas.Row;
  if (nFila < 1) or (nFila > sgPeliculas.RowCount-1) then Exit;

  obj := FListaPeliculas.Items[nFila-1] as TJSONObject;
  FEditandoID := StrToIntDef(sgPeliculas.Cells[0, nFila], 0);
  lblID.Caption := IntToStr(FEditandoID);
  edtTitulo.Text := obj.GetValue<string>('titulo', '');
  cmbGenero.Text := obj.GetValue<string>('genero', '');
  edtDuracion.Text := obj.GetValue<string>('duracion', '');
  edtPoster.Text := obj.GetValue<string>('poster', '');
end;

procedure TfrmPeliculas.btnRefrescarClick(Sender: TObject);
begin
  RefrescarLista;
end;

procedure TfrmPeliculas.btnNuevoClick(Sender: TObject);
begin
  LimpiarCampos;
  edtTitulo.SetFocus;
end;

function TfrmPeliculas.ObtenerDatosJSON: TJSONObject;
begin
  Result := TJSONObject.Create;
  try
    Result.AddPair('titulo', edtTitulo.Text);
    Result.AddPair('genero', cmbGenero.Text);
    Result.AddPair('duracion', StrToIntDef(edtDuracion.Text, 0));
    if Trim(edtPoster.Text) <> '' then
      Result.AddPair('poster', edtPoster.Text)
    else
      Result.AddPair('poster', '');
  except
    FreeAndNil(Result);
    raise;
  end;
end;

procedure TfrmPeliculas.btnGuardarClick(Sender: TObject);
var
  jDatos: TJSONObject;
  sMensaje: string;
  bExito: Boolean;
begin
  if Trim(edtTitulo.Text) = '' then
  begin
    MessageDlg('El título es obligatorio.', mtWarning, [mbOK], 0);
    edtTitulo.SetFocus;
    Exit;
  end;

  jDatos := ObtenerDatosJSON;
  try
    if FEditandoID = 0 then
      bExito := APICrear('peliculas', jDatos, sMensaje)
    else
      bExito := APIEditar('peliculas', FEditandoID, jDatos, sMensaje);

    if bExito then
    begin
      MostrarMensaje('Operación exitosa.');
      RefrescarLista;
      LimpiarCampos;
    end
    else
      MessageDlg('Error: ' + sMensaje, mtError, [mbOK], 0);
  finally
    jDatos.Free;
  end;
end;

procedure TfrmPeliculas.btnEliminarClick(Sender: TObject);
var
  sMensaje: string;
begin
  if FEditandoID = 0 then
  begin
    MessageDlg('Seleccione una película de la lista.', mtInformation, [mbOK], 0);
    Exit;
  end;

  if MessageDlg(Format('¿Eliminar película con ID %d?', [FEditandoID]),
    mtConfirmation, [mbYes, mbNo], 0) <> mrYes then Exit;

  if APIBorrar('peliculas', FEditandoID, sMensaje) then
  begin
    MostrarMensaje('Película eliminada.');
    RefrescarLista;
    LimpiarCampos;
  end
  else
    MessageDlg('Error al eliminar: ' + sMensaje, mtError, [mbOK], 0);
end;

end.