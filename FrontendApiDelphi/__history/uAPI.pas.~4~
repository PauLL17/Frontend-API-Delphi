unit uAPI;

interface

uses
  System.SysUtils, System.Classes,
  System.Net.HttpClient, System.Net.URLClient,
  System.JSON;

const
  BASE_URL = 'http://borjapau2026.fabricomiweb.com/';

var
  sTokenJWT     : string; { Token JWT guardado tras el login    }
  sRolUsuario   : string; { Rol del usuario autenticado         }
  sNombreUsuario: string; { Username del usuario autenticado    }

{ Autenticación }
function LoginAPI(const sUsuario, sClave: string; out sMensaje: string): Boolean;

{ CRUD genérico
  IMPORTANTE: el caller es responsable de liberar los objetos JSON devueltos }
function APIListar(const sEntidad: string; out jArray: TJSONArray; out sMensaje: string): Boolean;
function APIVer   (const sEntidad: string; nID: Integer; out jObj: TJSONObject; out sMensaje: string): Boolean;
function APICrear (const sEntidad: string; jDatos: TJSONObject; out sMensaje: string): Boolean;
function APIEditar(const sEntidad: string; nID: Integer; jDatos: TJSONObject; out sMensaje: string): Boolean;
function APIBorrar(const sEntidad: string; nID: Integer; out sMensaje: string): Boolean;

implementation

{ Ejecuta una llamada HTTP
  - Devuelve el código de estado HTTP (0 = error de red/conexión)
  - sRespuesta recibe el body de la respuesta como string }
function EjecutarLlamada(const sMetodo, sURL, sBody: string; out sRespuesta: string): Integer;
var
  oHTTP   : THTTPClient;
  oResp   : IHTTPResponse;
  oStream : TStringStream;
begin
  Result    := 0;
  sRespuesta := '';
  oHTTP := THTTPClient.Create;
  try
    try
      oHTTP.CustomHeaders['Authorization'] := 'Bearer ' + sTokenJWT;
      oHTTP.Accept := 'application/json';

      if (sMetodo = 'POST') or (sMetodo = 'PUT') or (sMetodo = 'PATCH') then
      begin
        oHTTP.CustomHeaders['Content-Type'] := 'application/json';
        oStream := TStringStream.Create(sBody, TEncoding.UTF8);
        try
          if      sMetodo = 'POST'  then oResp := oHTTP.Post (sURL, oStream)
          else if sMetodo = 'PUT'   then oResp := oHTTP.Put  (sURL, oStream)
          else                           oResp := oHTTP.Patch(sURL, oStream);
        finally
          oStream.Free;
        end;
      end
      else if sMetodo = 'GET'    then oResp := oHTTP.Get   (sURL)
      else if sMetodo = 'DELETE' then oResp := oHTTP.Delete(sURL)
      else raise Exception.CreateFmt('Método HTTP no soportado: %s', [sMetodo]);

      sRespuesta := oResp.ContentAsString(TEncoding.UTF8);
      Result     := oResp.StatusCode;

    except
      on E: Exception do
      begin
        sRespuesta := E.Message;
        Result     := 0;
      end;
    end;
  finally
    oHTTP.Free;
  end;
end;

{ Extrae el mensaje de error del JSON de respuesta si existe }
function ExtraerMensajeError(const sJSON: string): string;
var
  jVal: TJSONValue;
  jObj: TJSONObject;
begin
  Result := sJSON;
  jVal := TJSONObject.ParseJSONValue(sJSON);
  if not Assigned(jVal) then Exit;
  try
    if jVal is TJSONObject then
    begin
      jObj := TJSONObject(jVal);
      if jObj.TryGetValue<string>('message', Result) then Exit;
      if jObj.TryGetValue<string>('error',   Result) then Exit;
    end;
  finally
    jVal.Free;
  end;
end;


{ LOGIN                                                         }
function LoginAPI(const sUsuario, sClave: string; out sMensaje: string): Boolean;
var
  jCuerpo : TJSONObject;
  jResp   : TJSONValue;
  jUser   : TJSONObject;
  sResp   : string;
  nCodigo : Integer;
begin
  { LoginAPI
    - Construye el JSON con username y password
    - Llama a POST /Login
    - Si 200: guarda token, rol y username en variables globales
    - Si error: devuelve False y rellena sMensaje }
  Result   := False;
  sMensaje := '';

  jCuerpo := TJSONObject.Create;
  try
    jCuerpo.AddPair('username', sUsuario);
    jCuerpo.AddPair('password', sClave);
    nCodigo := EjecutarLlamada('POST', BASE_URL + 'Login', jCuerpo.ToJSON, sResp);
  finally
    jCuerpo.Free;
  end;

  if nCodigo = 0 then
  begin
    sMensaje := 'No se pudo conectar con el servidor: ' + sResp;
    Exit;
  end;

  jResp := TJSONObject.ParseJSONValue(sResp);
  if not Assigned(jResp) then
  begin
    sMensaje := 'Respuesta inválida del servidor.';
    Exit;
  end;

  try
    if nCodigo = 200 then
    begin
      sTokenJWT := (jResp as TJSONObject).GetValue<string>('token');
      jUser := (jResp as TJSONObject).GetValue<TJSONObject>('user');
      if Assigned(jUser) then
      begin
        sRolUsuario    := jUser.GetValue<string>('role');
        sNombreUsuario := jUser.GetValue<string>('username');
      end;
      Result := True;
    end
    else
      sMensaje := ExtraerMensajeError(sResp);
  finally
    jResp.Free;
  end;
end;


{ LISTAR -> GET /entidad                                         }
function APIListar(const sEntidad: string; out jArray: TJSONArray; out sMensaje: string): Boolean;
var
  sResp   : string;
  nCodigo : Integer;
  jVal    : TJSONValue;
begin
  Result   := False;
  jArray   := nil;
  sMensaje := '';

  nCodigo := EjecutarLlamada('GET', BASE_URL + sEntidad, '', sResp);

  if nCodigo = 0 then
  begin
    sMensaje := 'Error de conexión: ' + sResp;
    Exit;
  end;

  if nCodigo = 200 then
  begin
    jVal := TJSONObject.ParseJSONValue(sResp);
    if Assigned(jVal) and (jVal is TJSONArray) then
    begin
      jArray := TJSONArray(jVal);
      Result := True;
    end
    else
    begin
      FreeAndNil(jVal);
      sMensaje := 'La respuesta no es un array JSON válido.';
    end;
  end
  else
    sMensaje := ExtraerMensajeError(sResp);
end;


{ VER -> GET /entidad/id                                         }
function APIVer(const sEntidad: string; nID: Integer; out jObj: TJSONObject; out sMensaje: string): Boolean;
var
  sResp   : string;
  nCodigo : Integer;
  jVal    : TJSONValue;
begin
  Result   := False;
  jObj     := nil;
  sMensaje := '';

  nCodigo := EjecutarLlamada('GET',
    BASE_URL + sEntidad + '/' + IntToStr(nID), '', sResp);

  if nCodigo = 0 then
  begin
    sMensaje := 'Error de conexión: ' + sResp;
    Exit;
  end;

  if nCodigo = 200 then
  begin
    jVal := TJSONObject.ParseJSONValue(sResp);
    if Assigned(jVal) and (jVal is TJSONObject) then
    begin
      jObj   := TJSONObject(jVal);
      Result := True;
    end
    else
    begin
      FreeAndNil(jVal);
      sMensaje := 'La respuesta no es un objeto JSON válido.';
    end;
  end
  else
    sMensaje := ExtraerMensajeError(sResp);
end;

{ CREAR -> POST /entidad                                         }
function APICrear(const sEntidad: string; jDatos: TJSONObject; out sMensaje: string): Boolean;
var
  sResp   : string;
  nCodigo : Integer;
begin
  Result   := False;
  sMensaje := '';

  nCodigo := EjecutarLlamada('POST', BASE_URL + sEntidad, jDatos.ToJSON, sResp);

  if      nCodigo = 0             then sMensaje := 'Error de conexión: ' + sResp
  else if nCodigo in [200, 201]   then Result   := True
  else                                 sMensaje := ExtraerMensajeError(sResp);
end;


{ EDITAR -> PUT /entidad/id                                      }
function APIEditar(const sEntidad: string; nID: Integer; jDatos: TJSONObject; out sMensaje: string): Boolean;
var
  sResp   : string;
  nCodigo : Integer;
begin
  Result   := False;
  sMensaje := '';

  nCodigo := EjecutarLlamada('PUT',
    BASE_URL + sEntidad + '/' + IntToStr(nID), jDatos.ToJSON, sResp);

  if      nCodigo = 0           then sMensaje := 'Error de conexión: ' + sResp
  else if nCodigo in [200, 204] then Result   := True
  else                               sMensaje := ExtraerMensajeError(sResp);
end;


{ BORRAR -> DELETE /entidad/id                                   }
function APIBorrar(const sEntidad: string; nID: Integer; out sMensaje: string): Boolean;
var
  sResp   : string;
  nCodigo : Integer;
begin
  Result   := False;
  sMensaje := '';

  nCodigo := EjecutarLlamada('DELETE',
    BASE_URL + sEntidad + '/' + IntToStr(nID), '', sResp);

  if      nCodigo = 0           then sMensaje := 'Error de conexión: ' + sResp
  else if nCodigo in [200, 204] then Result   := True
  else                               sMensaje := ExtraerMensajeError(sResp);
end;

end.
